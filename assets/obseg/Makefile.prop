# prop

# Models are stored as raw binaries; the binary-to-C converters were removed.
# Stage them at the paths included by ob_seg.s without changing the source assets.
$(BUILD_DIR)/$(OBSEG_DIR)/prop/%.bin: $(OBSEG_DIR)/prop/%.bin
	@mkdir -p $(@D)
	cp $< $@

# Build PROP_NAMES from PROPNAMELIST
PROP_NAMES = $(foreach prop,$(PROPNAMELIST),P$(prop)Z)

PROP_BIN_FILES = $(addprefix $(BUILD_DIR)/$(OBSEG_DIR)/prop/, $(addsuffix .bin, $(PROP_NAMES)))

# Default target
all: $(PROP_BIN_FILES)

.PHONY: all
