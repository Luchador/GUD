# gun

# Models are stored as raw binaries; the binary-to-C converters were removed.
# Stage them at the paths included by ob_seg.s without changing the source assets.
$(BUILD_DIR)/$(OBSEG_DIR)/gun/%.bin: $(OBSEG_DIR)/gun/%.bin
	@mkdir -p $(@D)
	cp $< $@

# Build GUN_NAMES from GUNNAMELIST
GUN_NAMES = $(foreach gun,$(GUNNAMELIST),G$(gun)Z)

GUN_BIN_FILES = $(addprefix $(BUILD_DIR)/$(OBSEG_DIR)/gun/, $(addsuffix .bin, $(GUN_NAMES)))

# Default target
all: $(GUN_BIN_FILES)

.PHONY: all
