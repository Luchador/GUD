# chr

# Models are stored as raw binaries; the binary-to-C converters were removed.
# Stage them at the paths included by ob_seg.s without changing the source assets.
$(BUILD_DIR)/$(OBSEG_DIR)/chr/%.bin: $(OBSEG_DIR)/chr/%.bin
	@mkdir -p $(@D)
	cp $< $@

# Build CHR_NAMES from CHRNAMELIST
CHR_NAMES = $(foreach chr,$(CHRNAMELIST),C$(chr)Z)

CHR_BIN_FILES = $(addprefix $(BUILD_DIR)/$(OBSEG_DIR)/chr/, $(addsuffix .bin, $(CHR_NAMES)))

# Default target
all: $(CHR_BIN_FILES)

.PHONY: all
