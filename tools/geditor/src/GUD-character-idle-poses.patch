+/* Generated by tools/geditor/scripts/generate_idle_poses.py.
+   Viewport snapshots only; no runtime animation or root motion. */
+#ifndef GEDITOR_IDLEPOSES_H
+#define GEDITOR_IDLEPOSES_H
+
