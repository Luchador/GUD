+static const unsigned short g_EditorPose_idle_unarmed[45] = {
+    0xffa0, 0xfe70, 0xff70, 0xff90, 0x01c0, 0x0050, 0xffb0, 0x0030, 0x0070,
+    0x0370, 0x0040, 0xc310, 0xfe10, 0xfd40, 0x3f80, 0x0000, 0xeb40, 0x0000,
+    0x0000, 0x1060, 0x0000, 0xff70, 0x0a80, 0xf9e0, 0x0880, 0xfb30, 0x0270,
+    0x0280, 0xffd0, 0xc1a0, 0x0030, 0xffb0, 0x3d70, 0x0000, 0xffa0, 0x0000,
+    0x0000, 0xff40, 0x0000, 0xf550, 0x0130, 0xffb0, 0x00e0, 0x00b0, 0x0310,
+};
+
