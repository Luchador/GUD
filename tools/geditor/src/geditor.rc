#include <windows.h>
#include "resource.h"

IDI_GEDITOR ICON "icon.ico"
IDR_GIZMO_CYLINDER RCDATA "../geditorassets/gizmo_cylinder.glb"
IDR_GIZMO_SCALE RCDATA "../geditorassets/gizmo_scale.glb"
IDR_GIZMO_ARROW RCDATA "../geditorassets/gizmo_arrow.glb"
IDR_NO_TEXTURE RCDATA "../geditorassets/no_texture.png"

IDR_VERTEX_SELECT_OFF RCDATA "../geditorassets/verts_select_off.png"
IDR_VERTEX_SELECT_ON  RCDATA "../geditorassets/verts_select_on.png"
IDR_EDGE_SELECT_OFF   RCDATA "../geditorassets/edges_select_off.png"
IDR_EDGE_SELECT_ON    RCDATA "../geditorassets/edges_select_on.png"
IDR_FACE_SELECT_OFF   RCDATA "../geditorassets/faces_select_off.png"
IDR_FACE_SELECT_ON    RCDATA "../geditorassets/faces_select_on.png"
IDR_VERTEX_PAINT_OFF  RCDATA "../geditorassets/vertex_paint_off.png"
IDR_VERTEX_PAINT_ON   RCDATA "../geditorassets/vertex_paint_on.png"
IDR_VERTEX_SNAP_OFF   RCDATA "../geditorassets/vertex_snap_off.png"
IDR_VERTEX_SNAP_ON    RCDATA "../geditorassets/vertex_snap_on.png"

/*
 * New Project dialog. Units here are dialog units, not pixels: they
 * scale with the system font, which is what keeps the layout correct
 * on high-DPI displays.
 */
IDD_NEW_PROJECT DIALOGEX 0, 0, 300, 156
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Project"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Project name:", -1, 10, 10, 100, 8
    EDITTEXT        IDC_PROJECT_NAME, 10, 22, 280, 14, ES_AUTOHSCROLL

    LTEXT           "Location:", -1, 10, 44, 100, 8
    EDITTEXT        IDC_PROJECT_LOCATION, 10, 56, 232, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE_LOCATION, 246, 55, 44, 16

    LTEXT           "", IDC_NAME_WARNING, 10, 84, 280, 16

    LTEXT           "GUD ROM:", -1, 10, 100, 100, 8
    EDITTEXT        IDC_PROJECT_ROM, 10, 112, 232, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE_ROM, 246, 110, 44, 16

    LTEXT           "", IDC_NAME_WARNING, 10, 132, 280, 16
    DEFPUSHBUTTON   "Create Project", IDC_CREATE_PROJECT, 115, 132, 70, 16
END

/*
 * Builds a playable ROM from the open project's retained base ROM and
 * editable level files.
 */
IDD_CREATE_ROM DIALOGEX 0, 0, 300, 126
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create ROM"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "ROM name:", -1, 10, 10, 100, 8
    EDITTEXT        IDC_ROM_NAME, 10, 22, 280, 14, ES_AUTOHSCROLL

    LTEXT           "Output directory:", -1, 10, 44, 100, 8
    EDITTEXT        IDC_ROM_OUTPUT_DIR, 10, 56, 232, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE_ROM_OUTPUT, 246, 55, 44, 16

    LTEXT           "", IDC_ROM_WARNING, 10, 78, 280, 18

    DEFPUSHBUTTON   "Create ROM", IDC_CREATE_ROM, 105, 102, 70, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 180, 102, 50, 16
END

/* Modeless, resizable workspace for the face UV editing tools. */
IDD_UV_EDITOR DIALOGEX 0, 0, 780, 540
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "UV Editor"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "Move (W)", IDC_UV_MOVE, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP, 8, 6, 62, 20
    LTEXT           "Planar:", IDC_UV_PROJECT_LABEL, 80, 12, 40, 10
    PUSHBUTTON      "X-axis", IDC_UV_PROJECT_X, 128, 6, 48, 20, WS_GROUP
    PUSHBUTTON      "Y-axis", IDC_UV_PROJECT_Y, 184, 6, 48, 20
    PUSHBUTTON      "Z-axis", IDC_UV_PROJECT_Z, 240, 6, 48, 20
    PUSHBUTTON      "Best Fit", IDC_UV_PROJECT_BEST, 296, 6, 64, 20
    LTEXT           "Drag a box to select UV vertices.", IDC_UV_TOOL_HINT, 368, 12, 264, 10
    LTEXT           "Transform", IDC_UV_TRANSFORM, 648, 10, 120, 10
    LTEXT           "No UV vertices selected", IDC_UV_SELECTION, 648, 30, 120, 22
    LTEXT           "U", IDC_UV_U_LABEL, 648, 64, 12, 10
    EDITTEXT        IDC_UV_U, 666, 60, 102, 16, ES_AUTOHSCROLL
    LTEXT           "V", IDC_UV_V_LABEL, 648, 88, 12, 10
    EDITTEXT        IDC_UV_V, 666, 84, 102, 16, ES_AUTOHSCROLL
    LTEXT           "Select one UV vertex to set its coordinates.", IDC_UV_HINT, 648, 112, 120, 42
    PUSHBUTTON      "&Close", IDCANCEL, 648, 516, 120, 16
END
