/* Modeless workspace; leave room for material, color and face controls. */
IDD_MODEL_EDITOR DIALOGEX 0, 0, 780, 660
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Model Editor"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Characters", IDC_MODEL_CHARACTERS_LABEL, 8, 8, 244, 18
    COMBOBOX        IDC_MODEL_CHARACTERS, 8, 26, 244, 216, CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Items", IDC_MODEL_ITEMS_LABEL, 268, 8, 244, 18
    COMBOBOX        IDC_MODEL_ITEMS, 268, 26, 244, 216, CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Props", IDC_MODEL_PROPS_LABEL, 528, 8, 244, 18
    COMBOBOX        IDC_MODEL_PROPS, 528, 26, 244, 216, CBS_DROPDOWN | CBS_AUTOHSCROLL | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Export Model...", IDC_MODEL_EXPORT, 8, 52, 88, 18, WS_TABSTOP
    PUSHBUTTON      "Import Model...", IDC_MODEL_IMPORT, 104, 52, 88, 18, WS_TABSTOP
    PUSHBUTTON      "Add Prop Model...", IDC_MODEL_ADD, 200, 52, 96, 18, WS_TABSTOP
    PUSHBUTTON      "UV Editor (Ctrl+T)", IDC_MODEL_UV, 304, 52, 96, 18, WS_TABSTOP
    LTEXT           "Choose a model.", IDC_MODEL_STATUS, 8, 566, 680, 18, SS_ENDELLIPSIS
    PUSHBUTTON      "&Close", IDCANCEL, 702, 566, 70, 18
    /* Let the dialog erase behind these frames despite WS_CLIPCHILDREN. */
    GROUPBOX        "Materials", IDC_MODEL_MATERIALS, 588, 80, 184, 234, BS_GROUPBOX, WS_EX_TRANSPARENT
    LISTBOX         IDC_MODEL_MATERIAL_LIST, 596, 96, 168, 192, LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Separate shared LOD geometry", IDC_MODEL_SEPARATE_LODS, 596, 198, 168, 18, WS_TABSTOP
    PUSHBUTTON      "Make LOD untextured", IDC_MODEL_UNTEXTURED, 596, 220, 168, 18, WS_TABSTOP
    CONTROL         "Include shared faces", IDC_MODEL_SHARED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 596, 240, 168, 14
    LTEXT           "Drag an image onto a material.", IDC_MODEL_HINT, 596, 258, 168, 24
    GROUPBOX        "Vertex color (RGBA)", IDC_MODEL_COLORS, 588, 282, 184, 136, BS_GROUPBOX, WS_EX_TRANSPARENT
    GROUPBOX        "Face properties", IDC_MODEL_PROPERTIES, 588, 350, 184, 176, BS_GROUPBOX, WS_EX_TRANSPARENT
    LTEXT           "No faces selected", IDC_MODEL_SELECTION, 596, 366, 98, 12
    PUSHBUTTON      "Select all", IDC_MODEL_SELECT_ALL, 702, 362, 62, 18, WS_TABSTOP
    LTEXT           "Select faces to inspect their settings.", IDC_MODEL_CURRENT, 596, 386, 168, 42
    LTEXT           "Backface culling", IDC_MODEL_CULL_LABEL, 596, 432, 80, 12
    COMBOBOX        IDC_MODEL_CULL, 596, 446, 80, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Render mode", IDC_MODEL_SURFACE_LABEL, 684, 432, 80, 12
    COMBOBOX        IDC_MODEL_SURFACE, 684, 446, 80, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "U wrapping", IDC_MODEL_WRAP_U_LABEL, 596, 472, 80, 12
    COMBOBOX        IDC_MODEL_WRAP_U, 596, 486, 80, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "V wrapping", IDC_MODEL_WRAP_V_LABEL, 684, 472, 80, 12
    COMBOBOX        IDC_MODEL_WRAP_V, 684, 486, 80, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "LOD", IDC_MODEL_LOD_LABEL, 596, 512, 30, 12
    COMBOBOX        IDC_MODEL_LODS, 630, 508, 134, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

END

/* Modeless, resizable workspace for the face UV editing tools. */
IDD_UV_EDITOR DIALOGEX 0, 0, 780, 540
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "UV Editor"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "Move (W)", IDC_UV_MOVE, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP, 8, 6, 62, 20
    CONTROL         "Rotate (E)", IDC_UV_ROTATE, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE, 78, 6, 70, 20
    CONTROL         "Scale (R)", IDC_UV_SCALE, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE, 156, 6, 62, 20
    LTEXT           "Planar:", IDC_UV_PROJECT_LABEL, 226, 12, 40, 10, WS_GROUP
