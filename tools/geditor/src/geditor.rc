IDD_NEW_PROJECT DIALOGEX 0, 0, 300, 156
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Project"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Project name:", -1, 10, 10, 100, 8
    EDITTEXT        IDC_PROJECT_NAME, 10, 22, 280, 14, ES_AUTOHSCROLL

    LTEXT           "Location:", -1, 10, 44, 100, 8
    EDITTEXT        IDC_PROJECT_LOCATION, 10, 56, 232, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE_LOCATION, 246, 55, 44, 16

    LTEXT           "", IDC_NAME_WARNING, 10, 84, 280, 16

    LTEXT           "GUD ROM:", -1, 10, 100, 100, 8
    EDITTEXT        IDC_PROJECT_ROM, 10, 112, 232, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE_ROM, 246, 110, 44, 16

    LTEXT           "", IDC_NAME_WARNING, 10, 132, 280, 16
    DEFPUSHBUTTON   "Create Project", IDC_CREATE_PROJECT, 115, 132, 70, 16
END

/*
 * Builds a playable ROM from the open project's retained base ROM and
 * editable level files.
 */
IDD_CREATE_ROM DIALOGEX 0, 0, 300, 126
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create ROM"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "ROM name:", -1, 10, 10, 100, 8
    EDITTEXT        IDC_ROM_NAME, 10, 22, 280, 14, ES_AUTOHSCROLL

    LTEXT           "Output directory:", -1, 10, 44, 100, 8
    EDITTEXT        IDC_ROM_OUTPUT_DIR, 10, 56, 232, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE_ROM_OUTPUT, 246, 55, 44, 16

    LTEXT           "", IDC_ROM_WARNING, 10, 78, 280, 18

    DEFPUSHBUTTON   "Create ROM", IDC_CREATE_ROM, 105, 102, 70, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 180, 102, 50, 16
END

IDD_REBASE_PROJECT DIALOGEX 0, 0, 380, 340
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rebase Project"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Move your saved edits onto a newer GUD ROM in a new project folder.", -1, 10, 10, 360, 12
    LTEXT "New GUD ROM:", -1, 10, 29, 100, 10
    EDITTEXT IDC_REBASE_ROM, 10, 41, 300, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_REBASE_BROWSE_ROM, 316, 40, 54, 16
    LTEXT "New project name:", -1, 10, 65, 160, 10
    EDITTEXT IDC_REBASE_NAME, 10, 77, 360, 14, ES_AUTOHSCROLL
    LTEXT "Destination directory:", -1, 10, 101, 160, 10
    EDITTEXT IDC_REBASE_PARENT, 10, 113, 300, 14, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_REBASE_BROWSE_DIR, 316, 112, 54, 16
    CONTROL "Keep existing base images", IDC_REBASE_KEEP_IMAGES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 136, 200, 12
    LTEXT "Use the project's base textures and image settings when the new ROM differs.", -1, 22, 151, 348, 18
    EDITTEXT IDC_REBASE_REPORT, 10, 174, 360, 110, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    LTEXT "Save and Check saves current edits. Create Copy opens the new project.", -1, 10, 290, 360, 12
    DEFPUSHBUTTON "Save and Check", IDC_REBASE_CHECK, 136, 314, 88, 18
    PUSHBUTTON "Create Copy", IDC_REBASE_CREATE, 230, 314, 76, 18
    PUSHBUTTON "Cancel", IDCANCEL, 312, 314, 58, 18
END

/* Closing this prompt or pressing Escape cancels exiting. */
IDD_EXIT_UNSAVED DIALOGEX 0, 0, 344, 84
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Unsaved Changes"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "This project has unsaved changes.\nWhat would you like to do?", -1, 10, 12, 324, 30
    DEFPUSHBUTTON   "Save changes and &exit", IDYES, 10, 56, 106, 18
    PUSHBUTTON      "Exit &without saving", IDNO, 124, 56, 110, 18
    PUSHBUTTON      "&Cancel exiting", IDCANCEL, 242, 56, 92, 18
END

