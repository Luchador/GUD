/*
 * New Project dialog. Units here are dialog units, not pixels: they
 * scale with the system font, which is what keeps the layout correct
 * on high-DPI displays.
 */
IDD_CHECK_ISSUES DIALOGEX 0, 0, 740, 350
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Check for Issues"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Report:", IDC_ISSUES_SCOPE_LABEL, 8, 8, 76, 20
    COMBOBOX IDC_ISSUES_SCOPE, 92, 8, 252, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_ISSUES_STATUS, 8, 36, 724, 32
    CONTROL "", IDC_ISSUES_LIST, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 8, 40, 604, 188
    EDITTEXT IDC_ISSUES_DETAILS, 8, 236, 604, 60, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    PUSHBUTTON "&Check Again", IDC_ISSUES_CHECK, 8, 302, 84, 20
    DEFPUSHBUTTON "&Go to Issue", IDOK, 436, 302, 84, 20
    PUSHBUTTON "Close", IDCANCEL, 528, 302, 84, 20
END

IDD_IMPORT_IMAGE DIALOGEX 0, 0, 364, 302
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Import Image"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_IMAGE_SUMMARY, 10, 10, 344, 20, SS_PATHELLIPSIS
    GROUPBOX "Texture type", -1, 10, 34, 344, 114
    CONTROL "", 1110, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 20, 48, 164, 12
    CONTROL "", 1111, "Button", BS_AUTORADIOBUTTON, 20, 62, 164, 12
    CONTROL "", 1112, "Button", BS_AUTORADIOBUTTON, 20, 76, 164, 12
    CONTROL "", 1113, "Button", BS_AUTORADIOBUTTON, 20, 90, 164, 12
    CONTROL "", 1114, "Button", BS_AUTORADIOBUTTON, 20, 104, 164, 12
    CONTROL "", 1115, "Button", BS_AUTORADIOBUTTON, 20, 118, 164, 12
    CONTROL "", 1116, "Button", BS_AUTORADIOBUTTON, 20, 132, 164, 12
    CONTROL "", 1117, "Button", BS_AUTORADIOBUTTON, 190, 48, 154, 12
    CONTROL "", 1118, "Button", BS_AUTORADIOBUTTON, 190, 62, 154, 12
    CONTROL "", 1119, "Button", BS_AUTORADIOBUTTON, 190, 76, 154, 12
    CONTROL "", 1120, "Button", BS_AUTORADIOBUTTON, 190, 90, 154, 12
    CONTROL "", 1121, "Button", BS_AUTORADIOBUTTON, 190, 104, 154, 12
    CONTROL "", 1122, "Button", BS_AUTORADIOBUTTON, 190, 118, 154, 12
    LTEXT "Mipmaps:", -1, 10, 160, 60, 10, WS_GROUP
    COMBOBOX IDC_IMAGE_MIPMAPS, 78, 157, 276, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT "Hit sound:", -1, 10, 182, 156, 10
    LTEXT "Bullet hole:", -1, 190, 182, 164, 10
    COMBOBOX IDC_IMAGE_SOUND, 10, 194, 164, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_IMAGE_BULLET, 190, 194, 164, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_IMAGE_TMEM, 10, 219, 344, 20
    LTEXT "", IDC_IMAGE_WARNING, 10, 242, 344, 28
    DEFPUSHBUTTON "Import", IDC_IMAGE_IMPORT, 240, 278, 54, 16
    PUSHBUTTON "Cancel", IDCANCEL, 300, 278, 54, 16
END

