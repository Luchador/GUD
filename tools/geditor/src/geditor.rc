/*
 * New Project dialog. Units here are dialog units, not pixels: they
 * scale with the system font, which is what keeps the layout correct
 * on high-DPI displays.
 */
IDD_IMPORT_IMAGE DIALOGEX 0, 0, 364, 302
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Import Image"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "", IDC_IMAGE_SUMMARY, 10, 10, 344, 20, SS_PATHELLIPSIS
    GROUPBOX "Texture type", -1, 10, 34, 344, 114
    CONTROL "", 1110, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 20, 48, 164, 12
    CONTROL "", 1111, "Button", BS_AUTORADIOBUTTON, 20, 62, 164, 12
    CONTROL "", 1112, "Button", BS_AUTORADIOBUTTON, 20, 76, 164, 12
    CONTROL "", 1113, "Button", BS_AUTORADIOBUTTON, 20, 90, 164, 12
    CONTROL "", 1114, "Button", BS_AUTORADIOBUTTON, 20, 104, 164, 12
    CONTROL "", 1115, "Button", BS_AUTORADIOBUTTON, 20, 118, 164, 12
    CONTROL "", 1116, "Button", BS_AUTORADIOBUTTON, 20, 132, 164, 12
    CONTROL "", 1117, "Button", BS_AUTORADIOBUTTON, 190, 48, 154, 12
    CONTROL "", 1118, "Button", BS_AUTORADIOBUTTON, 190, 62, 154, 12
    CONTROL "", 1119, "Button", BS_AUTORADIOBUTTON, 190, 76, 154, 12
    CONTROL "", 1120, "Button", BS_AUTORADIOBUTTON, 190, 90, 154, 12
    CONTROL "", 1121, "Button", BS_AUTORADIOBUTTON, 190, 104, 154, 12
    CONTROL "", 1122, "Button", BS_AUTORADIOBUTTON, 190, 118, 154, 12
    LTEXT "Mipmaps:", -1, 10, 160, 60, 10, WS_GROUP
    COMBOBOX IDC_IMAGE_MIPMAPS, 78, 157, 276, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    LTEXT "Hit sound:", -1, 10, 182, 156, 10
    LTEXT "Bullet hole:", -1, 190, 182, 164, 10
    COMBOBOX IDC_IMAGE_SOUND, 10, 194, 164, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX IDC_IMAGE_BULLET, 190, 194, 164, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "", IDC_IMAGE_TMEM, 10, 219, 344, 20
    LTEXT "", IDC_IMAGE_WARNING, 10, 242, 344, 28
    DEFPUSHBUTTON "Import", IDC_IMAGE_IMPORT, 240, 278, 54, 16
    PUSHBUTTON "Cancel", IDCANCEL, 300, 278, 54, 16
END

IDD_NEW_PROJECT DIALOGEX 0, 0, 300, 156
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "New Project"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Project name:", -1, 10, 10, 100, 8
    EDITTEXT        IDC_PROJECT_NAME, 10, 22, 280, 14, ES_AUTOHSCROLL

    LTEXT           "Location:", -1, 10, 44, 100, 8
    EDITTEXT        IDC_PROJECT_LOCATION, 10, 56, 232, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE_LOCATION, 246, 55, 44, 16

    LTEXT           "", IDC_NAME_WARNING, 10, 84, 280, 16

    LTEXT           "GUD ROM:", -1, 10, 100, 100, 8
    EDITTEXT        IDC_PROJECT_ROM, 10, 112, 232, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE_ROM, 246, 110, 44, 16

    LTEXT           "", IDC_NAME_WARNING, 10, 132, 280, 16
    DEFPUSHBUTTON   "Create Project", IDC_CREATE_PROJECT, 115, 132, 70, 16
END

/*
 * Builds a playable ROM from the open project's retained base ROM and
 * editable level files.
 */
IDD_CREATE_ROM DIALOGEX 0, 0, 300, 126
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create ROM"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "ROM name:", -1, 10, 10, 100, 8
    EDITTEXT        IDC_ROM_NAME, 10, 22, 280, 14, ES_AUTOHSCROLL

    LTEXT           "Output directory:", -1, 10, 44, 100, 8
    EDITTEXT        IDC_ROM_OUTPUT_DIR, 10, 56, 232, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_BROWSE_ROM_OUTPUT, 246, 55, 44, 16

    LTEXT           "", IDC_ROM_WARNING, 10, 78, 280, 18

    DEFPUSHBUTTON   "Create ROM", IDC_CREATE_ROM, 105, 102, 70, 16
    PUSHBUTTON      "Cancel", IDCANCEL, 180, 102, 50, 16
END

/* Closing this prompt or pressing Escape cancels exiting. */
IDD_EXIT_UNSAVED DIALOGEX 0, 0, 344, 84
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Unsaved Changes"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "This project has unsaved changes.\nWhat would you like to do?", -1, 10, 12, 324, 30
    DEFPUSHBUTTON   "Save changes and &exit", IDYES, 10, 56, 106, 18
    PUSHBUTTON      "Exit &without saving", IDNO, 124, 56, 110, 18
    PUSHBUTTON      "&Cancel exiting", IDCANCEL, 242, 56, 92, 18
END

/* Same initial size and ownership behavior as the UV Editor. */
IDD_MODEL_EDITOR DIALOGEX 0, 0, 780, 540
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "Model Editor"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Characters", IDC_MODEL_CHARACTERS_LABEL, 8, 8, 244, 18
    COMBOBOX        IDC_MODEL_CHARACTERS, 8, 26, 244, 216, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Items", IDC_MODEL_ITEMS_LABEL, 268, 8, 244, 18
    COMBOBOX        IDC_MODEL_ITEMS, 268, 26, 244, 216, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Props", IDC_MODEL_PROPS_LABEL, 528, 8, 244, 18
    COMBOBOX        IDC_MODEL_PROPS, 528, 26, 244, 216, CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Export Model...", IDC_MODEL_EXPORT, 8, 52, 88, 18, WS_TABSTOP
    PUSHBUTTON      "Import Model...", IDC_MODEL_IMPORT, 104, 52, 88, 18, WS_TABSTOP
    LTEXT           "Choose a model.", IDC_MODEL_STATUS, 8, 514, 680, 18, SS_ENDELLIPSIS
    PUSHBUTTON      "&Close", IDCANCEL, 702, 514, 70, 18
END

/* Modeless, resizable workspace for the face UV editing tools. */
IDD_UV_EDITOR DIALOGEX 0, 0, 780, 540
STYLE DS_CENTER | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_TOOLWINDOW
CAPTION "UV Editor"
FONT 8, "MS Shell Dlg"
BEGIN
    CONTROL         "Move (W)", IDC_UV_MOVE, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE | WS_GROUP | WS_TABSTOP, 8, 6, 62, 20
    CONTROL         "Rotate (E)", IDC_UV_ROTATE, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE, 78, 6, 70, 20
    CONTROL         "Scale (R)", IDC_UV_SCALE, "BUTTON", BS_AUTORADIOBUTTON | BS_PUSHLIKE, 156, 6, 62, 20
    LTEXT           "Planar:", IDC_UV_PROJECT_LABEL, 226, 12, 40, 10, WS_GROUP
    PUSHBUTTON      "X-axis", IDC_UV_PROJECT_X, 274, 6, 48, 20
    PUSHBUTTON      "Y-axis", IDC_UV_PROJECT_Y, 330, 6, 48, 20
    PUSHBUTTON      "Z-axis", IDC_UV_PROJECT_Z, 386, 6, 48, 20
    PUSHBUTTON      "Best Fit", IDC_UV_PROJECT_BEST, 442, 6, 64, 20
    LTEXT           "Drag a box to select UV vertices.", IDC_UV_TOOL_HINT, 514, 12, 118, 10
    LTEXT           "Transform", IDC_UV_TRANSFORM, 648, 10, 120, 10
    LTEXT           "No UV vertices selected", IDC_UV_SELECTION, 648, 30, 120, 22
    LTEXT           "U", IDC_UV_U_LABEL, 648, 64, 12, 10
    EDITTEXT        IDC_UV_U, 666, 60, 102, 16, ES_AUTOHSCROLL
    LTEXT           "V", IDC_UV_V_LABEL, 648, 88, 12, 10
    EDITTEXT        IDC_UV_V, 666, 84, 102, 16, ES_AUTOHSCROLL
    LTEXT           "Select one UV vertex to set its coordinates.", IDC_UV_HINT, 648, 112, 120, 42
    PUSHBUTTON      "&Close", IDCANCEL, 648, 516, 120, 16
END
