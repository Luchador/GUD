    PUSHBUTTON "Edit...", IDC_INTRO_WEAPON_EDIT, 84, 148, 60, 18
    PUSHBUTTON "Remove", IDC_INTRO_WEAPON_REMOVE, 150, 148, 60, 18
    PUSHBUTTON "Move up", IDC_INTRO_WEAPON_UP, 216, 148, 60, 18
    PUSHBUTTON "Move down", IDC_INTRO_WEAPON_DOWN, 282, 148, 60, 18
    LTEXT "Starting ammo", IDC_INTRO_AMMO_LABEL, 18, 174, 520, 12
    LTEXT "Amounts use the game's ammo limits. For repeated ammo types, the last row takes effect.", IDC_INTRO_AMMO_HELP, 18, 188, 520, 20
    CONTROL "", IDC_INTRO_AMMO, "SysListView32", WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 18, 210, 520, 66, WS_EX_CLIENTEDGE
    PUSHBUTTON "Add...", IDC_INTRO_AMMO_ADD, 18, 278, 60, 18
    PUSHBUTTON "Edit...", IDC_INTRO_AMMO_EDIT, 84, 278, 60, 18
    PUSHBUTTON "Remove", IDC_INTRO_AMMO_REMOVE, 150, 278, 60, 18
    PUSHBUTTON "Move up", IDC_INTRO_AMMO_UP, 216, 278, 60, 18
    PUSHBUTTON "Move down", IDC_INTRO_AMMO_DOWN, 282, 278, 60, 18
    LTEXT "", IDC_LEVEL_ROOMS_STATUS, 18, 32, 520, 28
    CONTROL "", IDC_LEVEL_ROOMS_LIST, "SysListView32", WS_TABSTOP | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 18, 64, 520, 220, WS_EX_CLIENTEDGE
    LTEXT "", IDC_LEVEL_ROOMS_TOTALS, 18, 290, 520, 22
    PUSHBUTTON "&Close", IDCANCEL, 480, 332, 70, 18
END

