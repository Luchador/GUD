    LTEXT "", IDC_INTRO_STATUS, 18, 32, 520, 14
    LTEXT "Starting weapons", IDC_INTRO_WEAPONS_LABEL, 18, 48, 520, 12
    LTEXT "The first row is equipped at the start. Other rows add weapons to the inventory.", IDC_INTRO_WEAPONS_HELP, 18, 62, 520, 20
